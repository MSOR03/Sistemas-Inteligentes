# Ajustes del agente. Para usarlos, copiar este archivo como .env
# (en esta misma carpeta) y cambiar los valores. Una línea borrada o
# comentada usa el valor por defecto del código (config.py).
#
# Estos valores son el perfil RÁPIDO: sin pausas extra, mirando la
# pantalla más seguido y manteniendo la flecha en los tramos rectos.
# Cada movimiento se sigue comprobando en pantalla antes del siguiente.
# Si en una máquina lenta aparecen movimientos "no tuvo efecto", subir
# DR_STEP_DELAY (0.05 - 0.15) o volver a DR_HOLD_KEYS=0.
#
# También se pueden poner como variables de entorno, que mandan sobre
# el archivo; y las opciones de play.py (--delay, --countdown, ...)
# mandan sobre ambos.

# ---- Velocidad de los movimientos ------------------------------------

# Pausa extra (s) después de cada movimiento ya comprobado en pantalla.
# Bajarla para ir más rápido; subirla (0.15 - 0.3) si la máquina es
# lenta y el agente se adelanta al juego.
DR_STEP_DELAY=0

# Tiempo (s) que se mantiene pulsada cada flecha. Si el juego no
# registra algunas pulsaciones, subirlo a 0.1.
DR_KEY_HOLD=0.05

# Cada cuánto (s) se mira la pantalla mientras se espera un movimiento.
DR_POLL_INTERVAL=0.01

# Espera máxima (s) a que el jugador cambie de casilla antes de volver
# a pulsar la flecha. Solo cuenta si una pulsación se pierde. Mínimo
# 0.1; muy bajo, podría volver a pulsar mientras el juego todavía
# está empezando el movimiento.
DR_MOVE_TIMEOUT=0.6

# Espera máxima (s) a que termine una animación (empujar una roca,
# abrir una puerta). Normalmente termina antes; mínimo 0.1.
DR_SETTLE_TIMEOUT=1.0

# Veces que se pulsa una flecha antes de dar el movimiento por fallido.
DR_MAX_PRESSES=3

# Tiempo (s) que la imagen tiene que quedarse sin cambios para dar una
# animación por terminada. No bajarlo de 0.1: el juego dibuja por
# cuadros, y con menos dos capturas seguidas pueden caer en el mismo
# cuadro a mitad de un empujón y parecer quietas. Entonces el juego
# ignora la flecha siguiente y el agente pierde la cuenta de dónde está
# el jugador (pasó en el nivel 19). Subirlo (0.15) si vuelve a pasar.
DR_STILL_TIME=0.1

# Tiempo (s) que tarda una reja en abrirse o cerrarse. Si es menor que
# la animación real, el agente puede aprender algo falso.
DR_GATE_ANIMATION=0.4

# 1: en los tramos rectos que terminan contra un muro, mantener la
# flecha pulsada como una persona (el jugador camina sin pausas entre
# casillas). 0: una pulsación por casilla. Si el juego no mueve al
# jugador con la tecla pulsada, el agente lo nota y vuelve solo a una
# pulsación por casilla.
DR_HOLD_KEYS=1

# Casillas mínimas de un tramo para mantener la flecha pulsada.
DR_HOLD_MIN_RUN=2

# ---- Partida ----------------------------------------------------------

# Segundos para hacer clic en el juego antes de empezar.
DR_COUNTDOWN=3

# Segundos de espera entre un nivel y el siguiente.
DR_LEVEL_WAIT=3

# Veces que se replanifica en un nivel si un movimiento falla.
DR_REPLANS=6

# Niveles seguidos a jugar.
DR_LEVELS=1
